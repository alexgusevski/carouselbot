{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carouselbot-product-dev",
  "account_id": "0013d6c77fa95280762f403d53c52869",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carouselbot-product-dev",
      "database_id": "fa805421-2c9c-4202-86c0-297151bb44cf",
      "migrations_dir": "backend/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "carouselbot-product-dev"
    }
  ],
  "workflows": [
    {
      "name": "carouselbot-agent-dev",
      "binding": "AGENT_WORKFLOW",
      "class_name": "CarouselAgentWorkflow"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://carouselbot-product-dev.longformstudio-api.workers.dev",
    "CLERK_PUBLISHABLE_KEY": "pk_test_YXdhaXRlZC1sYWNld2luZy01NTg3LmNsZXJrLmFjY291bnRzLmRldiQ",
    "POLAR_PRODUCT_ID": "cd39dfb0-6110-4e40-ae3c-85a8405ac2a0",
    "POLAR_ENVIRONMENT": "production",
    "AGENT_ALLOWANCE_USD": "5",
    "JOB_BUDGET_USD": "0.5",
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAx5MU5UqqVYmf5rh/Fp+B\nDCw9Aw/+TuQN+SFkzijMtG8/tK0t97tgJ17djIqIw/Y9m5jTYzTsFAKBlDpSxV4p\nPmygBXcKPoiXSkHv6ekZrjscb4RKCIe88+wdzthxWXDj9EL0ZmlcRKxFb/DKk1o8\npQz+5kglOME+7n/R80sy4mGBZlCEopsq3mHmRoHXUend1aaOq62PsVntCDbbbyc/\nzsiaoNQznzH78hklCGzLXOEy8Rk8REkc2Phdn4hwQgU40xjNX3oJnEyLUx8jk+DY\ndINM2B7yx+zOyPJFxOrrWDaOcY8bLkVQNAyCNtWXNR9Xq3kp+FzZBau1ww1kOi1c\nFQIDAQAB\n-----END PUBLIC KEY-----\n"
