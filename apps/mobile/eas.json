{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "credentialsSource": "remote", "autoIncrement": true, "environment": "production", "android": { "buildType": "app-bundle" } }
  },
  "submit": { "production": { "android": { "track": "internal", "releaseStatus": "draft" } } }
}
