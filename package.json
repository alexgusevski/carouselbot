{
  "name": "carouselbot-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Carousel editor with local MCP and hosted AI generation",
  "homepage": "https://carousel.bot",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgusevski/carouselbot.git"
  },
  "bugs": {
    "url": "https://github.com/alexgusevski/carouselbot/issues"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "mcp": "node packages/mcp/src/cli.mjs serve",
    "mcp:doctor": "node packages/mcp/src/cli.mjs doctor",
    "mcp:pack": "npm pack --workspace carouselbot",
    "mcp:pack:legacy": "npm pack --workspace slides-studio-mcp",
    "test:migration": "node --test test/*.test.cjs",
    "test:migration:browser": "node scripts/test-domain-migration-browser.mjs",
    "test:editor": "node --test test/*.test.mjs",
    "test:editor:browser": "node scripts/test-editor-browser.mjs",
    "test": "npm run test:migration && npm run test:editor && npm run test:mcp && npm run test:product",
    "test:mcp": "node --test packages/mcp/test/*.test.mjs",
    "test:mcp:browser": "node scripts/test-mcp-browser-local.mjs --deployed --shared-daemon",
    "test:mcp:browser:local": "node scripts/test-mcp-browser-local.mjs",
    "build": "node scripts/build.mjs",
    "preview:cloudflare": "npm run build && wrangler pages dev dist",
    "deploy:test": "node scripts/deploy-test.mjs",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:product": "node --test backend/test/*.test.mjs test/hosted-agent.test.mjs",
    "preview:product": "npm run build && wrangler dev --config wrangler.product.jsonc",
    "deploy:product:dev": "npm run build && wrangler deploy --config wrangler.product.jsonc",
    "deploy:product": "node scripts/deploy-product.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "mediabunny": "1.60.0",
    "@clerk/backend": "^3.21.1",
    "@cloudflare/puppeteer": "^1.4.0",
    "@polar-sh/sdk": "^1.0.1",
    "openai": "^7.25.0"
  }
}
