/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; font-src 'self'; script-src 'self'; style-src 'self'; connect-src http://127.0.0.1:43117; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/agent-commands.js
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
